From b5b61d23e0dba86d748f7c4df0b63375928f3388 Mon Sep 17 00:00:00 2001
From: zimagen <zimagen@users.noreply.github.com>
Date: Fri, 23 Oct 2026 02:11:35 +0000
Subject: [PATCH] Local: omamori watch unlock on lock screen

---
 bin/omarchy-apply-lock          | 13 +++++++
 shell/plugins/lock/Service.qml  | 64 +++++++++++++++++++++++++++++++++
 test/shell.d/apply-lock-test.sh | 11 +++++-
 3 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/bin/omarchy-apply-lock b/bin/omarchy-apply-lock
index e7fcc1fa..90a715f7 100755
--- a/bin/omarchy-apply-lock
+++ b/bin/omarchy-apply-lock
@@ -55,6 +55,19 @@ else
   as_root rm -f /etc/pam.d/omarchy-lock-face
 fi
 
+# A paired watch (omamori) also gets a stack of its own, run beside the
+# others; pam_omamori waits for the watch and never touches the password.
+if [[ -f /usr/lib/security/pam_omamori.so ]]; then
+  echo "Configuring lock screen watch authentication..."
+  as_root tee /etc/pam.d/omarchy-lock-watch >/dev/null <<'EOF'
+#%PAM-1.0
+auth       required                    pam_omamori.so mode=lock
+account    include                     system-local-login
+EOF
+else
+  as_root rm -f /etc/pam.d/omarchy-lock-watch
+fi
+
 # Install resume recovery alongside fingerprint PAM, so setup and upgrades
 # cannot leave one configured without the other.
 resume_hook_src="$OMARCHY_PATH/default/systemd/system-sleep/fprintd-resume"
diff --git a/shell/plugins/lock/Service.qml b/shell/plugins/lock/Service.qml
index 17debdf3..7060b072 100644
--- a/shell/plugins/lock/Service.qml
+++ b/shell/plugins/lock/Service.qml
@@ -39,6 +39,12 @@ Item {
   property bool faceConfigured: false
   property bool faceAuthenticating: false
   property double faceLastStartMs: 0
+  // A paired watch (omamori) gets a PAM stack of its own too. pam_omamori
+  // blocks until the watch approves or the daemon drops the request, so one
+  // attempt stays open for the whole lock; a failed attempt (daemon down,
+  // not paired) retries on a slow timer. The password path is untouched.
+  property bool watchConfigured: false
+  property bool watchAuthenticating: false
   // While the lock has the displays off no new attempt starts, so the reader
   // isn't held awake all night; any wake starts it again.
   property bool fingerprintPaused: false
@@ -233,6 +239,9 @@ Item {
     if (passwordPam.active) passwordPam.abort()
     if (fingerprintPam.active) fingerprintPam.abort()
     if (facePam.active) facePam.abort()
+    watchAuthenticating = false
+    watchRetryTimer.stop()
+    if (watchPam.active) watchPam.abort()
   }
 
   function beginLock() {
@@ -485,6 +494,26 @@ Item {
     settleFaceAttempt()
   }
 
+  function startWatch() {
+    if (!lockRequested || !sessionLock.secure || !watchConfigured) return
+    if (watchPam.active || watchAuthenticating) return
+    watchAuthenticating = true
+    if (!watchPam.start()) {
+      watchAuthenticating = false
+      watchRetryTimer.restart()
+    }
+  }
+
+  function handleWatchFinished(result) {
+    watchAuthenticating = false
+    if (result === PamResult.Success && lockRequested) {
+      logEvent("watch-approved")
+      finishUnlock()
+      return
+    }
+    if (lockRequested) watchRetryTimer.restart()
+  }
+
   function startFingerprint() {
     if (!lockRequested || !sessionLock.secure || !fingerprintConfigured || fingerprintPaused) return
     if (fingerprintPam.active || fingerprintAuthenticating) return
@@ -578,6 +607,7 @@ Item {
         pendingSessionLockTimer.stop()
         root.startFingerprint()
         root.requestFace()
+        root.startWatch()
       }
     }
 
@@ -724,6 +754,20 @@ Item {
     }
   }
 
+  PamContext {
+    id: watchPam
+    config: "omarchy-lock-watch"
+    user: root.userName
+
+    onCompleted: function(result) {
+      root.handleWatchFinished(result)
+    }
+
+    onError: function(error) {
+      root.handleWatchFinished(PamResult.Error)
+    }
+  }
+
   // The lock only starts decoding its wallpaper once locked, and a machine
   // suspending right after locking froze that decode partway: waking showed
   // the password field on a bare background, then the wallpaper popped in.
@@ -818,6 +862,13 @@ Item {
     onTriggered: root.timeoutFaceReach()
   }
 
+  Timer {
+    id: watchRetryTimer
+    interval: 5000
+    repeat: false
+    onTriggered: root.startWatch()
+  }
+
   Process {
     id: readlinkProc
     command: ["bash", "-c", "path=$(readlink -f -- \"$1\") && printf '%s\\n%s\\n' \"$path\" \"$(stat -Lc %Y:%s -- \"$path\" 2>/dev/null)\"", "_", root.currentBackgroundLink]
@@ -1012,6 +1063,18 @@ Item {
     onFileChanged: reload()
   }
 
+  FileView {
+    path: "/etc/pam.d/omarchy-lock-watch"
+    watchChanges: true
+    printErrors: false
+    onLoaded: {
+      root.watchConfigured = true
+      root.startWatch()
+    }
+    onLoadFailed: root.watchConfigured = false
+    onFileChanged: reload()
+  }
+
   FileView {
     path: "/etc/pam.d/omarchy-lock-face"
     watchChanges: true
@@ -1066,6 +1129,7 @@ Item {
         fingerprint: root.fingerprintConfigured,
         fingerprintUnavailable: root.fingerprintUnavailable,
         face: root.faceConfigured,
+        watch: root.watchConfigured,
         authenticating: root.authenticating,
         lastEvent: root.lastEvent,
         lastEventAt: root.lastEventAt
diff --git a/test/shell.d/apply-lock-test.sh b/test/shell.d/apply-lock-test.sh
index bbc54a5b..9ed9828c 100644
--- a/test/shell.d/apply-lock-test.sh
+++ b/test/shell.d/apply-lock-test.sh
@@ -59,6 +59,7 @@ trusted_fprintd="$test_tmp/trusted-fprintd-list"
 password_pam="$test_tmp/omarchy-lock-password"
 fingerprint_pam="$test_tmp/omarchy-lock-fingerprint"
 face_pam="$test_tmp/omarchy-lock-face"
+watch_pam="$test_tmp/omarchy-lock-watch"
 attack_marker="$test_tmp/user-fprintd-list-ran"
 trusted_uid="$test_tmp/trusted-fprintd-list.uid"
 trusted_args="$test_tmp/trusted-fprintd-list.args"
@@ -112,6 +113,7 @@ prepare_helper() {
     -v password_pam="$password_pam" \
     -v fingerprint_pam="$fingerprint_pam" \
     -v face_pam="$face_pam" \
+    -v watch_pam="$watch_pam" \
     -v trusted_root_bin="$trusted_root_bin" \
     -v trusted_fprintd="$trusted_fprintd" \
     -v keep_root_path="$keep_root_path" \
@@ -125,6 +127,7 @@ prepare_helper() {
       gsub("/etc/pam\\.d/omarchy-lock-password", "\"" password_pam "\"", line)
       gsub("/etc/pam\\.d/omarchy-lock-fingerprint", "\"" fingerprint_pam "\"", line)
       gsub("/etc/pam\\.d/omarchy-lock-face", "\"" face_pam "\"", line)
+      gsub("/etc/pam\\.d/omarchy-lock-watch", "\"" watch_pam "\"", line)
 
       if (line == "if (( EUID == 0 )); then" && keep_root_path == 0) {
         print "if (( 0 )); then"
@@ -198,7 +201,7 @@ for helper in "$patched_helper" "$absolute_only_helper" "$root_path_only_helper"
 done
 
 reset_runtime_files() {
-  rm -f "$password_pam" "$fingerprint_pam" "$face_pam" "$trusted_uid" "$trusted_args" "$attack_marker" "$attack_args"
+  rm -f "$password_pam" "$fingerprint_pam" "$face_pam" "$watch_pam" "$trusted_uid" "$trusted_args" "$attack_marker" "$attack_args"
 }
 
 run_as_root() {
@@ -223,6 +226,12 @@ if [[ -f /usr/lib/security/pam_howdy.so ]]; then
 else
   [[ ! -e $face_pam ]] || fail "no face stack is written without the howdy module"
 fi
+if [[ -f /usr/lib/security/pam_omamori.so ]]; then
+  grep -q 'pam_omamori.so mode=lock' "$watch_pam" || fail "an installed omamori module gets a watch stack of its own"
+  ! grep -q 'pam_omamori.so' "$password_pam" || fail "the password stack never carries the watch module"
+else
+  [[ ! -e $watch_pam ]] || fail "no watch stack is written without the omamori module"
+fi
 [[ -x $test_tmp/system-sleep/fprintd-resume ]] ||
   fail "the lock helper installs the resume hook beside the fingerprint PAM file"
 [[ -f $test_tmp/fprintd.service.d/10-stop-timeout.conf ]] ||
-- 
2.47.3

