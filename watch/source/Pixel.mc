        0x00,0x00,0x1E,0x11,0x11,0x11,0x11,
        0x00,0x00,0x0E,0x11,0x11,0x11,0x0E,
        0x00,0x00,0x1E,0x11,0x1E,0x10,0x10,
        0x00,0x00,0x0F,0x11,0x0F,0x01,0x01,
        0x00,0x00,0x16,0x19,0x10,0x10,0x10,
        0x00,0x00,0x0F,0x10,0x0E,0x01,0x1E,
        0x08,0x08,0x1C,0x08,0x08,0x09,0x06,
        0x00,0x00,0x11,0x11,0x11,0x13,0x0D,
        0x00,0x00,0x11,0x11,0x11,0x0A,0x04,
        0x00,0x00,0x11,0x11,0x15,0x15,0x0A,
        0x00,0x00,0x11,0x0A,0x04,0x0A,0x11,
        0x00,0x00,0x11,0x11,0x0F,0x01,0x0E,
        0x00,0x00,0x1F,0x02,0x04,0x08,0x1F,
        0x02,0x04,0x04,0x08,0x04,0x04,0x02,
        0x04,0x04,0x04,0x04,0x04,0x04,0x04,
        0x08,0x04,0x04,0x02,0x04,0x04,0x08,
        0x00,0x00,0x08,0x15,0x02,0x00,0x00,
        0x00,0x00,0x04,0x0E,0x04,0x00,0x00,
        0x00,0x00,0x00,0x1F,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x15
    ]b;
    // All icons share an 11x11 grid; the charm also defines the launcher mark.
    const CHARM=[0x020,0x070,0x0F8,0x1FC,0x3DE,0x3FE,0x38E,0x38E,0x38E,0x3FE,0x3FE];
    const LOCK=[0x070,0x088,0x104,0x104,0x3FE,0x3FE,0x3DE,0x3DE,0x3FE,0x3FE,0];
    const TERMINAL=[0,0x100,0x080,0x040,0x020,0x040,0x080,0x100,0x01F,0,0];
    const CHECK=[0,0,0x002,0x004,0x008,0x110,0x0A0,0x040,0,0,0];
    const CROSS=[0,0x102,0x084,0x048,0x030,0x030,0x048,0x084,0x102,0,0];
    const KEY=[0x0E0,0x110,0x110,0x0E0,0x040,0x040,0x070,0x040,0x070,0,0];
    function glyph(c as Char) as Number {
        var n=c.toNumber();
        if(n>=32 && n<=126) {return n-32;}
        if(n==0x2022) {return 95;}if(n==0x2014) {return 96;}if(n==0x2026) {return 97;}
        return -1;
    }
    function fits(s as String) as Boolean {
        var chars=s.toCharArray();for(var i=0;i<chars.size();i++) {if(glyph(chars[i])<0) {return false;}}return true;
    }
    function cell(d as Number) as Number {return d+((d/4)>1?d/4:1);}
    function textWidth(s as String,d as Number) as Number {
        var n=s.toCharArray().size();return n==0?0:n*6*cell(d)-cell(d)- (cell(d)-d);
    }
    function measure(dc as Graphics.Dc,s as String,d as Number) as Number {
        return fits(s)?textWidth(s,d):dc.getTextWidthInPixels(s,Graphics.FONT_XTINY);
    }
    function lineHeight(dc as Graphics.Dc,d as Number) as Number {
        var h=7*cell(d)+3;var system=dc.getFontHeight(Graphics.FONT_XTINY)+2;return h>system?h:system;
    }
    function drawText(dc as Graphics.Dc,x as Number,y as Number,s as String,d as Number,color as Number,justify as Number) as Void {
        dc.setColor(color,BG);
        if(!fits(s)) {dc.drawText(x,y,Graphics.FONT_XTINY,s,justify);return;}
        if(justify==Graphics.TEXT_JUSTIFY_CENTER) {x-=textWidth(s,d)/2;}
        var chars=s.toCharArray();var step=cell(d);var dot=d==1?step:d;
        for(var i=0;i<chars.size();i++) {
            var offset=glyph(chars[i])*7;
            for(var row=0;row<7;row++) {var bits=FONT[offset+row];for(var col=0;col<5;col++) {if((bits&(1<<(4-col)))!=0) {dc.fillRectangle(x+col*step,y+row*step,dot,dot);}}}
            x+=6*step;
        }
    }
    function icon(dc as Graphics.Dc,x as Number,y as Number,rows as Array<Number>,d as Number,color as Number) as Void {
        dc.setColor(color,BG);var step=cell(d);var dot=d==1?step:d;
        for(var row=0;row<rows.size();row++) {for(var col=0;col<11;col++) {if((rows[row]&(1<<(10-col)))!=0) {dc.fillRectangle(x+col*step,y+row*step,dot,dot);}}}
    }
}
